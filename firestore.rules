rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isDriver() {
      return isSignedIn() && userDoc().data.role == 'driver';
    }

    function isNanny() {
      return isSignedIn() && userDoc().data.role == 'nanny';
    }

    function isCashier() {
      return isSignedIn() && userDoc().data.role == 'cashier';
    }

    function myStaffId() {
      return userDoc().data.staffId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn() && request.auth.uid == uid && (
        (
          request.resource.data.role == 'admin' &&
          exists(/databases/$(database)/documents/admins/$(myEmail()))
        ) ||
        (
          (request.resource.data.role == 'driver' || request.resource.data.role == 'nanny') &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.staffId)).data.email.lower() == myEmail() &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.staffId)).data.role == request.resource.data.role
        )
      );

      allow update, delete: if false;
    }

    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /schools/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /units/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /drivers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    match /pricingConcepts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Compatibilidad con registros antiguos; ya no se crean desde la app.
    match /pricing/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /routeLists/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /financeRecords/{id} {
      allow read, write: if isAdmin() || isCashier();
    }

    match /routes/{id} {
      allow read: if isSignedIn();
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == myStaffId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['studentOrderMorning', 'studentOrderAfternoon',
                      'avgStopMinutesMorning', 'avgStopMinutesAfternoon', 'updatedAt']));
      allow create, delete: if isAdmin();
    }

    match /students/{id} {
      allow read: if isSignedIn();
      // El admin puede modificar cualquier campo. El cajero SOLO puede
      // tocar lo relacionado con el cobro (estatus, vencimiento, montos),
      // nunca datos del alumno (nombre, domicilio, ruta, etc). El
      // chofer/nanny SOLO puede tocar el espejo de "última ubicación de
      // entrega" que se escribe automáticamente al marcar a un alumno
      // como entregado (ver markStopManual/markAllBulk en trips.js).
      allow update: if isAdmin() ||
        (isCashier() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'paymentStatusUpdatedAt', 'paymentStatusUpdatedBy',
                      'nextDueDate', 'lastPaymentAt', 'lastPaymentAmount', 'lastPaymentMethod',
                      'billingAmount', 'billingMode'])) ||
        ((isDriver() || isNanny()) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastDeliveredLocation', 'lastDeliveredAt', 'lastDeliveredTripId']));
      allow create, delete: if isAdmin();

      // Bitácora de cobranza (folio, monto, método, quién y cuándo).
      // Es información financiera — solo admin y cajero la ven/tocan.
      match /payments/{paymentId} {
        allow read, write: if isAdmin() || isCashier();
      }
    }

    // Los reportes usan una consulta collectionGroup sobre payments.
    // Esta regla es necesaria para autorizar esa consulta transversal.
    match /{path=**}/payments/{paymentId} {
      allow read, write: if isAdmin() || isCashier();
    }

    // Lectura de recorridos: cualquier miembro del personal con sesión
    // iniciada puede leer (es una app interna, todo el personal es de
    // confianza). Ojo: NO se puede restringir esto a "solo mis propios
    // recorridos" con reglas de Firestore, porque varias pantallas hacen
    // consultas por ruta/turno/fecha (no por chofer) — p. ej. el mapa de
    // referencia y el recorrido en curso buscan "el último recorrido
    // completado de ESTA ruta", sin importar qué chofer lo manejó ese
    // día (pudo haber sido un sustituto). Una regla que exigiera
    // resource.data.driverId == miStaffId en una consulta que no filtra
    // por driverId hace que Firestore rechace la consulta COMPLETA con
    // "Missing or insufficient permissions", aunque el chofer sí tenga
    // derecho a ver esos datos.
    match /trips/{tripId} {
      allow read: if isSignedIn();

      allow create: if isDriver() && request.resource.data.driverId == myStaffId();

      allow update: if isAdmin()
        || (isDriver() && resource.data.driverId == myStaffId())
        || (isNanny() && resource.data.nannyId == myStaffId() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['liveLocation', 'bulkEventAt', 'bulkEventLocation', 'alert', 'updatedAt']));

      match /stops/{studentId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isDriver() || isNanny();
      }
    }

    // Nómina / bitácora diaria de personal (horarios, bonos, sustitutos).
    // Es información de RH — solo el admin la ve o la toca.
    match /staffLogs/{date} {
      allow read: if isAdmin();
      match /entries/{entryId} {
        allow read, write: if isAdmin();
      }
    }

    // "Buzón" de la extensión Trigger Email (firestore-send-email): la
    // app solo escribe aquí el aviso a mandar; la extensión ya
    // configurada en Firebase es quien realmente lo envía por SMTP.
    match /mail/{id} {
      allow create: if isAdmin() || isCashier();
      allow read: if isAdmin() || isCashier();
    }

    // ------------------------------------------------------------------
    // Colecciones públicas (SIN login) para el seguimiento del padre de
    // familia. Contienen deliberadamente lo mínimo: matrícula -> ruta, y
    // un espejo de solo-lectura del recorrido del día (posición del
    // camión + estado por parada). Nunca exponen domicilio, contacto del
    // padre, ni el expediente completo del alumno.
    // ------------------------------------------------------------------
    match /publicStudentIndex/{matricula} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicTracking/{tripId} {
      allow read: if true;
      allow write: if isAdmin() || isDriver() || isNanny();
    }
  }
}
