rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isDriver() {
      return isSignedIn() && userDoc().data.role == 'driver';
    }

    function isNanny() {
      return isSignedIn() && userDoc().data.role == 'nanny';
    }

    function myStaffId() {
      return userDoc().data.staffId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn() && request.auth.uid == uid && (
        (
          request.resource.data.role == 'admin' &&
          exists(/databases/$(database)/documents/admins/$(myEmail()))
        ) ||
        (
          (request.resource.data.role == 'driver' || request.resource.data.role == 'nanny') &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.staffId)).data.email.lower() == myEmail() &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.staffId)).data.role == request.resource.data.role
        )
      );

      allow update, delete: if false;
    }

    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /schools/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /units/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /drivers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /routes/{id} {
      allow read: if isSignedIn();
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == myStaffId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['studentOrderMorning', 'studentOrderAfternoon', 'updatedAt']));
      allow create, delete: if isAdmin();
    }

    match /students/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // El chofer es el único que puede crear el recorrido (requiere el
    // kilometraje inicial, validado en la app) y cerrarlo (kilometraje
    // final). La nanny puede leerlo y actualizar solo lo relacionado con
    // marcar alumnos/ubicación en vivo — nunca el kilometraje ni el status.
    match /trips/{tripId} {
      allow read: if isAdmin()
        || (isDriver() && (resource == null || resource.data.driverId == myStaffId()))
        || (isNanny() && resource != null && resource.data.nannyId == myStaffId());

      allow create: if isDriver() && request.resource.data.driverId == myStaffId();

      allow update: if isAdmin()
        || (isDriver() && resource.data.driverId == myStaffId())
        || (isNanny() && resource.data.nannyId == myStaffId() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['liveLocation', 'bulkEventAt', 'bulkEventLocation', 'alert', 'updatedAt']));

      match /stops/{studentId} {
        allow read: if isAdmin() || isDriver() || isNanny();
        allow write: if isAdmin() || isDriver() || isNanny();
      }
    }

    // ------------------------------------------------------------------
    // Colecciones públicas (SIN login) para el seguimiento del padre de
    // familia. Contienen deliberadamente lo mínimo: matrícula -> ruta, y
    // un espejo de solo-lectura del recorrido del día (posición del
    // camión + estado por parada). Nunca exponen domicilio, contacto del
    // padre, ni el expediente completo del alumno.
    // ------------------------------------------------------------------
    match /publicStudentIndex/{matricula} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicTracking/{tripId} {
      allow read: if true;
      allow write: if isAdmin() || isDriver() || isNanny();
    }
  }
}
