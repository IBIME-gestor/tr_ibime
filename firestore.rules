rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isDriver() {
      return isSignedIn() && userDoc().data.role == 'driver';
    }

    function myDriverId() {
      return userDoc().data.driverId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn() && request.auth.uid == uid && (
        (
          request.resource.data.role == 'admin' &&
          exists(/databases/$(database)/documents/admins/$(myEmail()))
        ) ||
        (
          request.resource.data.role == 'driver' &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.email.lower() == myEmail()
        )
      );

      allow update, delete: if false;
    }

    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /schools/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /units/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /drivers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /routes/{id} {
      allow read: if isSignedIn();
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == myDriverId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['studentOrderMorning', 'studentOrderAfternoon', 'updatedAt']));
      allow create, delete: if isAdmin();
    }

    match /students/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /trips/{tripId} {
      allow read: if isAdmin() || (isDriver() && (resource == null || resource.data.driverId == myDriverId()));
      allow create: if isDriver() && request.resource.data.driverId == myDriverId();
      allow update: if isAdmin() || (isDriver() && resource.data.driverId == myDriverId());

      match /stops/{studentId} {
        allow read: if isAdmin() || isDriver();
        allow write: if isAdmin() || isDriver();
      }
    }

    // ------------------------------------------------------------------
    // Colecciones públicas (SIN login) para el seguimiento del padre de
    // familia. Contienen deliberadamente lo mínimo: matrícula -> ruta, y
    // un espejo de solo-lectura del recorrido del día (posición del
    // camión + estado por parada). Nunca exponen domicilio, contacto del
    // padre, ni el expediente completo del alumno.
    // ------------------------------------------------------------------
    match /publicStudentIndex/{matricula} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicTracking/{tripId} {
      allow read: if true;
      allow write: if isAdmin() || isDriver();
    }
  }
}
