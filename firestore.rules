rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('activo', true) != false;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserProfile() && userDoc().data.role == 'admin';
    }

    function isDriver() {
      return hasUserProfile() && userDoc().data.role == 'driver';
    }

    function isNanny() {
      return hasUserProfile() && userDoc().data.role == 'nanny';
    }

    function isCashier() {
      return hasUserProfile() && userDoc().data.role == 'cashier';
    }

    function myStaffId() {
      return userDoc().data.staffId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid && (
        (
          request.resource.data.role == 'admin' &&
          exists(/databases/$(database)/documents/admins/$(myEmail()))
        ) ||
        (
          (request.resource.data.role == 'driver' || request.resource.data.role == 'nanny' || request.resource.data.role == 'cashier') &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.staffId)).data.email.lower() == myEmail() &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.staffId)).data.role == request.resource.data.role
        )
      );

      allow update, delete: if isAdmin();
    }

    match /admins/{email} {
      allow get: if isSignedIn() && request.auth.token.email != null && email == request.auth.token.email.lower();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /schools/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /units/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // El operador solo puede dejar el último km (odómetro) al cerrar un recorrido o viaje.
      allow update: if isAdmin() ||
        (isDriver() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastKm', 'lastKmAt', 'lastKmTripId']));
    }

    // Viajes especiales (solicitados por dirección/coordinación): el admin los
    // gestiona; el operador asignado solo ve los suyos y registra inicio y cierre.
    match /specialTrips/{id} {
      allow read: if isAdmin() || (isDriver() && resource.data.operatorId == myStaffId());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isDriver() && resource.data.operatorId == myStaffId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'startedAt', 'endedAt', 'unitId', 'unitName',
                      'kmInicial', 'kmFinal', 'studentsStart', 'studentsEnd',
                      'operatorNotes', 'kmAlert', 'updatedAt']));
    }

    // Gasolina y mantenimiento/reparaciones de cada unidad: solo el admin.
    match /unitFuelLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /unitMaintenance/{id} {
      allow read, write: if isAdmin();
    }

    match /drivers/{id} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.token.email != null &&
         resource.data.email == request.auth.token.email.lower());
      allow write: if isAdmin();
    }


    match /pricingConcepts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Compatibilidad con registros antiguos; ya no se crean desde la app.
    match /pricing/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /routeLists/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /routeDrafts/{id} {
      allow read, write: if isAdmin();
    }

    match /financeRecords/{id} {
      allow read, write: if isAdmin() || isCashier();
    }

    match /routes/{id} {
      allow read: if isSignedIn();
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == myStaffId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['studentOrderMorning', 'studentOrderAfternoon',
                      'avgStopMinutesMorning', 'avgStopMinutesAfternoon', 'updatedAt']));
      allow create, delete: if isAdmin();
    }

    match /students/{id} {
      allow read: if isSignedIn();
      // El admin puede modificar cualquier campo. El cajero SOLO puede
      // tocar lo relacionado con el cobro (estatus, vencimiento, montos),
      // nunca datos del alumno (nombre, domicilio, ruta, etc). El
      // chofer/nanny SOLO puede tocar el espejo de "última ubicación de
      // entrega" que se escribe automáticamente al marcar a un alumno
      // como entregado (ver markStopManual/markAllBulk en trips.js).
      allow update: if isAdmin() ||
        (isCashier() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'paymentStatusUpdatedAt', 'paymentStatusUpdatedBy',
                      'nextDueDate', 'lastPaymentAt', 'lastPaymentAmount', 'lastPaymentMethod',
                      'billingAmount', 'billingMode'])) ||
        ((isDriver() || isNanny()) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastDeliveredLocation', 'lastDeliveredAt', 'lastDeliveredTripId']));
      allow create, delete: if isAdmin();

      // Bitácora de cobranza (folio, monto, método, quién y cuándo).
      // Es información financiera — solo admin y cajero la ven/tocan.
      match /payments/{paymentId} {
        allow read, write: if isAdmin() || isCashier();
      }
    }

    // Los reportes usan una consulta collectionGroup sobre payments.
    // Esta regla es necesaria para autorizar esa consulta transversal.
    match /{path=**}/payments/{paymentId} {
      allow read, write: if isAdmin() || isCashier();
    }

    // Lectura de recorridos: cualquier miembro del personal con sesión
    // iniciada puede leer (es una app interna, todo el personal es de
    // confianza). Ojo: NO se puede restringir esto a "solo mis propios
    // recorridos" con reglas de Firestore, porque varias pantallas hacen
    // consultas por ruta/turno/fecha (no por chofer) — p. ej. el mapa de
    // referencia y el recorrido en curso buscan "el último recorrido
    // completado de ESTA ruta", sin importar qué chofer lo manejó ese
    // día (pudo haber sido un sustituto). Una regla que exigiera
    // resource.data.driverId == miStaffId en una consulta que no filtra
    // por driverId hace que Firestore rechace la consulta COMPLETA con
    // "Missing or insufficient permissions", aunque el chofer sí tenga
    // derecho a ver esos datos.
    match /trips/{tripId} {
      allow read: if isSignedIn();

      allow create: if isDriver() && request.resource.data.driverId == myStaffId();

      allow update: if isAdmin()
        || (isDriver() && resource.data.driverId == myStaffId())
        || (isNanny() && resource.data.nannyId == myStaffId() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['liveLocation', 'bulkEventAt', 'bulkEventLocation', 'alert', 'updatedAt']));

      match /stops/{studentId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isDriver() || isNanny();
      }

      // Huella GPS del recorrido: la sube el operador de ese viaje; solo el admin la lee.
      match /track/{chunkId} {
        allow read: if isAdmin();
        allow create: if isAdmin() ||
          (isDriver() && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == myStaffId());
        allow update, delete: if isAdmin();
      }
    }

    // Banco de alumnos por asignar: el operador/nanny deja aquí a quien
    // agrega al momento en un recorrido (ver src/firebase/assignmentBank.js);
    // solo el admin lo lee y lo resuelve.
    match /assignmentBank/{studentId} {
      function bankKeys() {
        return ['studentId', 'matricula', 'name', 'schoolId', 'studentRouteId', 'routeId',
                'routeName', 'shift', 'date', 'tripId', 'configured', 'addedByStaffId',
                'addedByName', 'addedByRole', 'status', 'events', 'lastAddedAt', 'updatedAt'];
      }

      allow read: if isAdmin();

      allow create: if (isDriver() || isNanny())
        && request.resource.data.status == 'pending'
        && request.resource.data.studentId == studentId
        && request.resource.data.keys().hasOnly(bankKeys());

      // El operador solo puede volver a registrar al alumno (reabre como pendiente).
      allow update: if isAdmin()
        || ((isDriver() || isNanny())
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(bankKeys()));

      allow delete: if isAdmin();
    }

    // Nómina / bitácora diaria de personal (horarios, bonos, sustitutos).
    // Es información de RH — solo el admin la ve o la toca.
    match /staffLogs/{date} {
      allow read: if isAdmin();
      match /entries/{entryId} {
        allow read, write: if isAdmin();
      }
    }

    // ------------------------------------------------------------------
    // Soporte (Admin → Soporte).
    // clientErrors: errores que reporta la app (papás y operadores sin
    // login incluidos), por eso crear es abierto pero con campos acotados;
    // solo el admin lee, cambia el estatus o borra.
    // auditLog: bitácora de cambios; la escribe cualquier personal con
    // sesión, solo el admin la lee y nadie la edita ni la borra.
    // ------------------------------------------------------------------
    match /clientErrors/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'fingerprint', 'message', 'stack', 'source', 'route', 'role', 'uid',
          'actorName', 'actorEmail', 'device', 'online', 'viewport', 'sessionId',
          'extra', 'status', 'createdAt', 'expireAt'
        ])
        && request.resource.data.status == 'open'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 400
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /auditLog/{id} {
      allow create: if hasUserProfile();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // "Buzón" de la extensión Trigger Email (firestore-send-email): la
    // app solo escribe aquí el aviso a mandar; la extensión ya
    // configurada en Firebase es quien realmente lo envía por SMTP.
    match /mail/{id} {
      allow create: if isAdmin() || isCashier();
      allow read: if isAdmin() || isCashier();
    }

    match /notificationCampaigns/{id} {
      allow read, write: if isAdmin();
    }

    // Conciliación de reportes de Cometa. El admin y caja pueden
    // consultar/importar; la confirmación se registra en los módulos
    // financieros existentes y queda además auditada aquí.
    match /cometaImports/{id} {
      allow read, write: if isAdmin() || isCashier();
    }

    match /cometaRecords/{id} {
      allow read, write: if isAdmin() || isCashier();
    }

    // Banco de pagos Cometa (un documento por pago; nunca se borran).
    match /cometaPayments/{id} {
      allow read, write: if isAdmin() || isCashier();
    }

    // ------------------------------------------------------------------
    // Portal externo de operadores (/operador/:token).
    // El enlace (operatorLinks/{token}) lo crea y administra SOLO el admin.
    // El token es largo y aleatorio: quien lo tiene puede leer su enlace y
    // capturar/ver SUS solicitudes (subcolección). Lo capturado queda en
    // "pending": nunca toca students ni routeLists; solo el admin aprueba
    // (la aprobación escribe en students/routeLists con permisos de admin).
    // ------------------------------------------------------------------
    match /operatorLinks/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // Directorio de alumnos para el autocompletado del operador (solo el admin lo escribe).
      match /directory/{chunkId} {
        allow get, list: if isAdmin() ||
          (get(/databases/$(database)/documents/operatorLinks/$(token)).data.active == true);
        allow write: if isAdmin();
      }

      match /submissions/{subId} {
        function linkActive() {
          return get(/databases/$(database)/documents/operatorLinks/$(token)).data.active == true;
        }

        function validContent(d) {
          return d.matricula is string && d.matricula.size() > 0 && d.matricula.size() <= 40
            && d.name is string && d.name.size() > 0 && d.name.size() <= 120
            && d.routeId is string
            && d.tipoServicio in ['completo', 'medio', 'diario'];
        }

        allow get, list: if isAdmin() || linkActive();

        allow create: if linkActive()
          && request.resource.data.status == 'pending'
          && request.resource.data.linkToken == token
          && validContent(request.resource.data)
          && request.resource.data.keys().hasOnly([
               'matricula', 'name', 'nivel', 'grado', 'familiarResponsable', 'telefono',
               'address', 'routeId', 'routeName', 'schoolId', 'tipoServicio',
               'medioServicio', 'diasSemana', 'fechasDiarias',
               'linkToken', 'status', 'createdAt'
             ]);

        allow update: if isAdmin()
          || (linkActive()
              && resource.data.status in ['pending', 'rejected']
              && request.resource.data.status == 'pending'
              && validContent(request.resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'matricula', 'name', 'nivel', 'grado', 'familiarResponsable', 'telefono',
                   'address', 'routeId', 'routeName', 'schoolId', 'tipoServicio',
                   'medioServicio', 'diasSemana', 'fechasDiarias',
                   'status', 'rejectReason', 'updatedAt'
                 ]));

        allow delete: if isAdmin() || (linkActive() && resource.data.status == 'pending');
      }
    }

    // Consulta transversal (collectionGroup) del admin sobre todas las solicitudes.
    match /{path=**}/submissions/{subId} {
      allow read: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Colecciones públicas (SIN login) para el seguimiento del padre de
    // familia. Contienen deliberadamente lo mínimo: matrícula -> ruta, y
    // un espejo de solo-lectura del recorrido del día (posición del
    // camión + estado por parada). Nunca exponen domicilio, contacto del
    // padre, ni el expediente completo del alumno.
    // ------------------------------------------------------------------
    match /publicStudentIndex/{matricula} {
      // La búsqueda pública solo debe leer una matrícula concreta; no permite enumerar la colección.
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /publicTracking/{tripId} {
      // Seguimiento por ID conocido; se prohíbe listar todos los recorridos públicos.
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() ||
        ((isDriver() || isNanny()) &&
          exists(/databases/$(database)/documents/trips/$(tripId)) &&
          (get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == myStaffId() ||
           get(/databases/$(database)/documents/trips/$(tripId)).data.nannyId == myStaffId()));
      allow delete: if isAdmin();
    }
  }
}
